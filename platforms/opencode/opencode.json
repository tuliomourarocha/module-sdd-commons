{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "plugin": [
    {
      "name": "rtk-visibility",
      "hooks": ["tool.execute.before", "tool.execute.after"],
      "description": "Shows ⟐ rtk ✓ footer on shell commands for token economy visibility"
    }
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow"
  },
  "experimental": {
    "primary_tools": ["edit", "bash"]
  }
}
